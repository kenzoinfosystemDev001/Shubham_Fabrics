// Shubham Fabrics MES - Enterprise PostgreSQL Schema (Neon Cloud)

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTHENTICATION & DATA-DRIVEN RBAC
// ==========================================

model User {
  id             String     @id @default(uuid())
  username       String     @unique
  email          String     @unique
  fullName       String
  passwordHash   String
  departmentCode String?    // Primary station affinity
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userRoles      UserRole[]
  createdPrograms Program[]  @relation("ProgramCreator")
  approvedPrograms Program[] @relation("ProgramApprover")
  auditLogs      AuditLog[]
  attachments    Attachment[]
  createdChallans Challan[]  @relation("ChallanCreator")
  issuedChallans  Challan[]  @relation("ChallanIssuer")
  receivedChallans Challan[] @relation("ChallanReceiver")
  approvedChallans Challan[] @relation("ChallanApprover")
  createdShrinkage ShrinkageRecord[] @relation("ShrinkageCreator")
  updatedShrinkage ShrinkageRecord[] @relation("ShrinkageUpdater")
  fabricPhotos     FabricPhoto[]     @relation("FabricPhotoUploader")
  productionRecords ProductionTransaction[] @relation("OperatorProduction")
  inspections    QualityInspection[] @relation("InspectorQuality")
  challanEvents  ChallanEvent[]
  stockLedgerEntries StockLedgerEntry[]
  dispatchesApproved DispatchOrder[] @relation("DispatchApprover")
  dispatchesOperated DispatchOrder[] @relation("DispatchOperator")
  defectsDetected    DefectRecord[]  @relation("DefectDetector")
  reworkOperations   ReworkTransaction[] @relation("ReworkOperator")
  recutsRequested    RecutRequest[]  @relation("RecutRequester")
  recutsApproved     RecutRequest[]  @relation("RecutApprover")

  // Fabric Store back-relations
  fabricBatchesCreated FabricBatch[]      @relation("FabricBatchCreator")
  grnReceived          MaterialReceipt[]  @relation("GRNReceiver")
  fabricRollsInspected FabricStoreRoll[]  @relation("FabricRollQCInspector")
  fabricQCInspections  FabricQCInspection[] @relation("FabricQCInspector")
  fabricLedgerEntries  FabricStockLedger[]  @relation("FabricLedgerTransactor")
  dyeingOrdersIncharge DyeingOrder[]        @relation("DyeingInchargeUser")
  dyeingOrdersReceived DyeingOrder[]        @relation("DyeingReceiver")
  dyeingColorReviews   DyeingOrder[]        @relation("DyeingColorReviewer")
  dyeingQcTransfers    DyeingQcTransfer[]   @relation("DyeingQcTransferCreator")
  workItemsReceived    DepartmentWorkItem[] @relation("WorkItemReceiver")
  workTransfers        DepartmentWorkTransfer[] @relation("WorkTransferCreator")
  workInspections      WorkItemInspection[] @relation("WorkItemInspector")
  workAllocations      WorkItemAllocation[] @relation("AllocationCreator")
  packingAllocations   PackingAllocation[]  @relation("PackingAllocationCreator")
  garmentImagesUploaded GarmentImage[]      @relation("GarmentImageUploader")
  holdsPlaced           DepartmentHold[]      @relation("HoldPlacer")
  holdEvents            DepartmentHoldEvent[] @relation("HoldEventActor")

  // Smart Deadline Alerts
  deadlineAlertDismissals DeadlineAlertDismissal[]
  fabricStockImportsUploaded FabricStockImport[] @relation("FabricStockImportUploader")
  fabricStockImportsPosted   FabricStockImport[] @relation("FabricStockImportPoster")

  // Sidebar department images
  departmentImagesUploaded DepartmentImage[] @relation("DepartmentImageUploader")
  brandingAssetsUploaded   BrandingAsset[]   @relation("BrandingAssetUploader")

  @@index([username])
  @@index([email])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. SUPER_ADMIN, PRODUCTION_MANAGER, STORE_MANAGER, etc.
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  rolePerms   RolePermission[]

  @@index([code])
}

model Permission {
  id          String           @id @default(uuid())
  module      String           // PROGRAM, CHALLAN, INVENTORY, MASTER_DATA, QUALITY, AUDIT
  resource    String           // PROGRAM_FILE, ROUTE, BOM, SUPPLIER, FABRIC, etc.
  action      String           // CREATE, READ, UPDATE, DELETE, APPROVE, ISSUE, RECEIVE
  description String?
  createdAt   DateTime         @default(now())

  rolePerms   RolePermission[]

  @@unique([module, resource, action])
  @@index([module, resource])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
}

// ==========================================
// 2. PLANT INFRASTRUCTURE & MASTERS
// ==========================================

model Department {
  id            String       @id @default(uuid())
  code          String       @unique // STORE, DYEING, QC1, CUTTING, etc.
  name          String
  sequenceOrder Int
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workCenters   WorkCenter[]
  operations    Operation[]
  defectCodes   DefectCode[]
  fromChallans  Challan[]    @relation("FromDepartment")
  toChallans    Challan[]    @relation("ToDepartment")
  sidebarImage  DepartmentImage?

  @@index([code])
}

model WorkCenter {
  id              String     @id @default(uuid())
  code            String     @unique
  name            String
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  capacityPerHour Float?     @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  machines        Machine[]

  @@index([code])
}

model Machine {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  machineType  String     // AUTO_CUTTER, SEWING_SINGLE_NEEDLE, OVERLOCK, SPREADER, etc.
  workCenterId String
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  serialNumber String?
  status       String     @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, BREAKDOWN
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([code])
}

model Shift {
  id            String   @id @default(uuid())
  code          String   @unique // SHIFT_A, SHIFT_B, SHIFT_C
  name          String
  startTime     String   // e.g. "08:00"
  endTime       String   // e.g. "16:30"
  durationHours Float    @default(8.0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// 3. COMMERCIAL PARTNERS MASTERS
// ==========================================

model Supplier {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxNumber     String?      // GSTIN / VAT
  paymentTerms  String?
  rating        Float?       @default(5.0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  fabrics       Fabric[]
  trims         Trim[]
  bomItems      ProgramBOM[]
  fabricRolls   FabricRoll[]

  @@index([code])
}

model Customer {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  country       String    @default("India")
  buyerGroup    String?
  currency      String    @default("INR")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  designs       Design[]
  programs      Program[]
  dispatches    DispatchOrder[]

  @@index([code])
}

// ==========================================
// 4. MATERIAL & STYLE CATALOG MASTERS
// ==========================================

model Item {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  itemType       String       // FABRIC, TRIM, PACKAGING, CONSUMABLE
  uom            String       // MTR, KG, PCS, YDS, ROLL
  currentStock   Float        @default(0)
  minStockAlert  Float        @default(10)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bomItems       ProgramBOM[]

  @@index([code])
}

model Fabric {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  fabricType    String          // KNIT_PIQUE, SINGLE_JERSEY, FLEECE, RIB, WOVEN_TWILL
  composition   String          // 100% Cotton, 95% Cotton 5% Spandex, etc.
  widthInInches Float
  gsm           Float
  weaveType     String?
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  programFabrics ProgramFabric[]

  @@index([code])
}

model Trim {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  trimCategory  String   // BUTTON, ZIP, THREAD, LABEL, TAG, BAG, CARTON, INTERLINING
  specification String?
  uom           String
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
}

model Design {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  designVersion String    @default("v1.0")
  season        String?   // Spring/Summer 2026, Autumn/Winter 2026
  patternNumber String
  category      String    // POLO, TSHIRT, HOODIE, SHIRT, TROUSER
  description   String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  programs      Program[]

  @@index([code])
}

model Colour {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  hexCode       String?
  pantoneCode   String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  programFabrics ProgramFabric[]
  programColours ProgramColour[]

  @@index([code])
}

model Size {
  id            String                 @id @default(uuid())
  code          String                 @unique // XS, S, M, L, XL, XXL, etc.
  name          String
  sortOrder     Int                    @default(1)
  sizeGroup     String                 @default("ADULT") // ADULT, YOUTH, INFANT
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  programSizes  ProgramSize[]
  specifications ProgramSpecification[]

  @@index([code])
}

// ==========================================
// 5. OPERATIONS & DEFECT TAXONOMY MASTERS
// ==========================================

model Operation {
  id                      String             @id @default(uuid())
  code                    String             @unique
  name                    String
  departmentId            String
  department              Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  standardCycleTimeSeconds Float             @default(60)
  difficultyLevel         String             @default("STANDARD") // SIMPLE, STANDARD, COMPLEX
  pieceRate               Float?             @default(0)
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  routeSteps              ProgramRouteStep[]

  @@index([code])
}

model DefectCode {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  category     String     // WEAVING, DYEING, CUTTING, STITCHING, EMBROIDERY, FINISHING
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  severity     String     @default("MAJOR") // MINOR, MAJOR, CRITICAL
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([code])
}

// ==========================================
// 6. PROGRAM FILE MANAGEMENT
// ==========================================

model Program {
  id              String                 @id @default(uuid())
  programNumber   String                 @unique // e.g. PRG-2026-0001
  programDate     DateTime               @default(now())
  customerId      String?
  customer        Customer?              @relation(fields: [customerId], references: [id])
  buyerName       String                 // Fallback if ad-hoc
  orderNumber     String
  designId        String?
  design          Design?                @relation(fields: [designId], references: [id])
  designName      String
  styleCode       String
  productCategory String
  targetQuantity  Int
  deliveryDate    DateTime
  priority        String                 @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status          String                 @default("DRAFT")  // DRAFT, SUBMITTED, APPROVED, IN_PRODUCTION, ON_HOLD, COMPLETED, CANCELLED
  remarks         String?

  createdById     String
  createdBy       User                   @relation("ProgramCreator", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?                  @relation("ProgramApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  // Shubham Fabrics Production Sheet Specific Fields
  programSerialNo          String?
  startDate                DateTime?
  designNumber             String?
  clientName               String?
  clientPriority           String?
  mainStyle                String?
  subStyle                 String?
  pattern                  String?
  baseDesignType           String?
  baseDesignPhoto          String?
  wilcomDesignNumber       String?
  wilcomDesignPhoto        String?
  embroideryDesign         String?
  embroideryDesignSize     String?
  fabricName               String?
  fabricType               String?
  fabricWidth              String?
  fabricWidthInches        Float?
  fabricColor              String?
  fabricColorAvailable     String?
  fabricAverage            Float?
  fabricAverageType        String?
  fabricAverageMeasurement String?
  fabricDyeingRequired     Boolean   @default(false)
  fabricIssuedToDyeing     Float?
  fabricSentToDyeing       Float?
  colorQuantity            Int?
  quantityMeasurement      String?
  specialMaterial          String?
  specialMaterialQuantity  String?
  productionDesignDate     DateTime?
  productionEndDate        DateTime?
  piecesRejection          Int?      @default(0)
  rejectionReason          String?
  comments                 String?
  metadataJson             String?   @db.Text

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  fabrics         ProgramFabric[]
  colours         ProgramColour[]
  sizes           ProgramSize[]
  specifications  ProgramSpecification[]
  bomItems        ProgramBOM[]
  routes          ProgramRoute[]
  challans        Challan[]
  challanItems    ChallanItem[]          @relation("ChallanItemProgram")
  shrinkageRecords ShrinkageRecord[]
  fabricPhotos    FabricPhoto[]
  productionLogs  ProductionTransaction[]
  rolls           FabricRoll[]
  bundles         Bundle[]
  cartons         Carton[]
  defects         DefectRecord[]
  stockLedgerEntries StockLedgerEntry[]
  reworkTransactions ReworkTransaction[]
  recutRequests   RecutRequest[]

  // Fabric Store back-relations
  fabricBatches   FabricBatch[]
  fabricStoreRolls FabricStoreRoll[] @relation("FabricRollIssuedToProgram")
  dyeingOrders     DyeingOrder[]
  deadlineAlerts   DeadlineAlert[]

  @@index([programNumber])
  @@index([status])
  departmentWorkItems DepartmentWorkItem[]
  garmentImages       GarmentImage[]
  departmentHolds     DepartmentHold[]
}

model ProgramFabric {
  id                  String   @id @default(uuid())
  programId           String
  program             Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  fabricId            String?
  fabric              Fabric?  @relation(fields: [fabricId], references: [id])
  fabricCode          String
  fabricName          String
  composition         String
  widthInInches       Float
  gsm                 Float
  colourId            String?
  colourRel           Colour?  @relation(fields: [colourId], references: [id])
  colour              String
  shade               String?
  requiredQuantity    Float
  uom                 String   @default("KG")
  tolerancePercentage Float    @default(5.0)
  wastagePercentage   Float    @default(3.0)
  createdAt           DateTime @default(now())
}

model ProgramColour {
  id             String   @id @default(uuid())
  programId      String
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  colourId       String?
  colourRel      Colour?  @relation(fields: [colourId], references: [id])
  colorCode      String
  colorName      String
  shade          String?
  targetQuantity Int
  createdAt      DateTime @default(now())
}

model ProgramSize {
  id             String   @id @default(uuid())
  programId      String
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  sizeId         String?
  sizeRel        Size?    @relation(fields: [sizeId], references: [id])
  size           String
  targetQuantity Int
  createdAt      DateTime @default(now())
}

model ProgramSpecification {
  id           String   @id @default(uuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  sizeId       String?
  sizeRel      Size?    @relation(fields: [sizeId], references: [id])
  size         String
  length       Float
  chest        Float
  waist        Float
  shoulder     Float
  sleeveLength Float
  armhole      Float
  neck         Float
  bottom       Float
  otherSpecs   String?  // JSON structured additional points of measure
  toleranceMm  Float    @default(5.0)
  createdAt    DateTime @default(now())
}

model ProgramBOM {
  id                       String    @id @default(uuid())
  programId                String
  program                  Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  itemId                   String?
  item                     Item?     @relation(fields: [itemId], references: [id])
  itemCode                 String
  itemName                 String
  category                 String    // MAIN_FABRIC, LINING, THREAD, BUTTON, ZIP, LABEL, TAG, BAG, CARTON
  requiredQuantityPerPiece Float
  uom                      String
  wastagePercentage        Float     @default(2.0)
  totalRequiredQuantity    Float
  supplierId               String?
  supplier                 Supplier? @relation(fields: [supplierId], references: [id])
  createdAt                DateTime  @default(now())
}

model ProgramRoute {
  id          String             @id @default(uuid())
  programId   String
  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  routeName   String             @default("Standard Garment Flow")
  description String?
  isDefault   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  steps       ProgramRouteStep[]
}

model ProgramRouteStep {
  id                     String       @id @default(uuid())
  programRouteId         String
  programRoute           ProgramRoute @relation(fields: [programRouteId], references: [id], onDelete: Cascade)
  sequenceOrder          Int
  departmentCode         String
  operationId            String?
  operation              Operation?   @relation(fields: [operationId], references: [id])
  isMandatory            Boolean      @default(true)
  requiresQCGate         Boolean      @default(false)
  expectedDurationMinutes Float?      @default(45.0)
  inputType              String       @default("FABRIC_ROLL") // FABRIC_ROLL, CUT_PANEL, BUNDLE, PIECE, CARTON
  outputType             String       @default("CUT_PANEL")
  reworkAllowed          Boolean      @default(true)
  skipAllowed            Boolean      @default(false)
  isParallel             Boolean      @default(false)
  createdAt              DateTime     @default(now())

  @@unique([programRouteId, sequenceOrder])
}

// ==========================================
// 7. AUDIT TRAIL & ATTACHMENTS
// ==========================================

model Attachment {
  id           String   @id @default(uuid())
  entityType   String   // Program, Design, Challan, QualityInspection
  entityId     String
  fileName     String
  fileType     String
  fileUrl      String
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// Sidebar artwork for a department. One row per department (unique departmentId);
// replacing the image updates the row and bumps `version`, which the image route uses as its ETag.
// The file lives on Cloudinary when it is configured (imageUrl + storageKey), otherwise in imageData.
model DepartmentImage {
  id              String     @id @default(uuid())
  departmentId    String     @unique
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  storageProvider String     // CLOUDINARY | DATABASE
  storageKey      String?    // Cloudinary public_id
  imageUrl        String?    // Cloudinary secure_url
  imageData       Bytes?     // Raw bytes when storageProvider = DATABASE
  mimeType        String     // image/jpeg | image/png | image/webp
  fileName        String
  fileSize        Int
  altText         String
  isActive        Boolean    @default(true)
  version         Int        @default(1)
  uploadedById    String?
  uploadedBy      User?      @relation("DepartmentImageUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([isActive])
}

// Admin-managed branding images keyed by slot (e.g. LOGIN_BACKGROUND). One row per slot;
// replacing bumps `version` (the image route's ETag). Same storage rules as DepartmentImage.
model BrandingAsset {
  id              String   @id @default(uuid())
  key             String   @unique // LOGIN_BACKGROUND
  storageProvider String   // CLOUDINARY | DATABASE
  storageKey      String?  // Cloudinary public_id
  imageUrl        String?  // Cloudinary secure_url
  imageData       Bytes?   // Raw bytes when storageProvider = DATABASE
  mimeType        String
  fileName        String
  fileSize        Int
  altText         String
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  uploadedById    String?
  uploadedBy      User?    @relation("BrandingAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Small admin-managed application settings keyed by name (e.g. APP_BACKGROUND_ENABLED).
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  action      String   // PROGRAM_CREATED, PROGRAM_APPROVED, MASTER_CREATED, USER_ROLE_ASSIGNED, etc.
  entity      String   // Program, Supplier, Fabric, User, Role, etc.
  entityId    String
  beforeState String?  // JSON stringified snapshot
  afterState  String?  // JSON stringified snapshot
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ==========================================
// 8. CHALLAN & PRODUCTION (MES EXECUTION)
// ==========================================

model Challan {
  id              String    @id @default(uuid())
  challanNumber   String    // unique per issuing department: see @@unique([fromDepartment, challanNumber])
  challanType     String    // FABRIC_ISSUE, INTER_DEPARTMENT, etc.
  programId       String
  program         Program   @relation(fields: [programId], references: [id])
  parentChallanId String?
  parentChallan   Challan?  @relation("ChallanGenealogy", fields: [parentChallanId], references: [id])
  childChallans   Challan[] @relation("ChallanGenealogy")

  fromDepartment  String
  fromDeptRel     Department @relation("FromDepartment", fields: [fromDepartment], references: [code])
  toDepartment    String
  toDeptRel       Department @relation("ToDepartment", fields: [toDepartment], references: [code])

  status          String    @default("DRAFT")
  priority        String    @default("NORMAL")

  issuedDate      DateTime?
  receivedDate    DateTime?
  completedDate   DateTime?

  createdById     String
  createdBy       User      @relation("ChallanCreator", fields: [createdById], references: [id])
  issuedById      String?
  issuedBy        User?     @relation("ChallanIssuer", fields: [issuedById], references: [id])
  receivedById    String?
  receivedBy      User?     @relation("ChallanReceiver", fields: [receivedById], references: [id])
  approvedById    String?
  approvedBy      User?     @relation("ChallanApprover", fields: [approvedById], references: [id])

  remarks         String?
  inchargeName    String?   // the issuing department incharge's name as typed on the form
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Fabric / Piece In & Out Auto-Detection Tracking across Departments
  fabricIn               Float?
  fabricOut              Float?
  fabricUnit             String?   @default("MTR") // MTR | PCS | MIXED (lines in both units: totals come from the lines)
  defectivePieces        Float?    @default(0) // defective quantity, in defectiveUnit
  defectiveUnit          String?   // MTR | PCS; null on older challans, which used fabricUnit
  defectiveShelfLocation String?
  defectReason           String?
  detectedFromChallanId  String?
  detectedFromDepartment String?

  items           ChallanItem[]
  productionLogs  ProductionTransaction[]
  inspections     QualityInspection[]
  events          ChallanEvent[]
  bundles         Bundle[]
  defects         DefectRecord[]

  // Dyeing back-relations
  dyeingInboundOrders DyeingOrder[] @relation("DyeingInboundChallan")
  dyeingQc1Orders     DyeingOrder[] @relation("DyeingQc1Challan")
  dyeingQcTransfers   DyeingQcTransfer[] @relation("DyeingQcTransferChallan")
  workItemsInbound    DepartmentWorkItem[] @relation("WorkItemInboundChallan")
  workTransfers       DepartmentWorkTransfer[] @relation("WorkTransferChallan")

  // Smart Deadline Alerts
  deadlineAlerts      DeadlineAlert[]

  shrinkageRecords    ShrinkageRecord[]

  // A department cannot reuse its own challan number; another department may use the same number.
  @@unique([fromDepartment, challanNumber])
  @@index([challanNumber])
}

model ChallanItem {
  id              String   @id @default(uuid())
  challanId       String
  challan         Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  itemDescription String
  fabricCode      String?
  colour          String?  // current fabric colour as issued
  shade           String?  // current shade as issued
  requiredColour  String?  // colour Dyeing must achieve (Store -> Dyeing lines); null when not specified
  requiredQuantity Float?  // quantity to dye in this line's uom; null when not specified
  fabricProcessingStatus String? // DYED | UNDYED for this line; null on lines recorded before it existed
  garmentCategory String?  // TOP | BOTTOM | DUPATTA | OTHERS (Recutting -> Stitching lines)
  styleRef        String?  // style / sub-style the line is to be stitched as
  size            String?
  unitType        String
  rollNumber      String?
  lotNumber       String?
  bundleNumber    String?
  barcode         String?
  quantity        Float
  grossWeightKg   Float?
  netWeightKg     Float?
  uom             String
  average         Float?   // Average entered with the line on the issuing form; null when not given
  averageUnit     String?  // MTR or PCS: the unit of `average` (chosen with it); null when no average
  unitQuantity    Float?   // Unit quantity entered with the line (Items: Size | Average | Unit); information only, stock moves by `quantity`
  unitQuantityUom String?  // MTR or PCS: the unit of `unitQuantity` (chosen with it); null when none
  remarks         String?

  sourceLotId     String?
  sourceRollId    String?
  sourceBundleId  String?
  // Production Sheet this line belongs to. One challan may carry lines of several sheets; null on
  // lines recorded before per-line sheets, which belong to the challan's own sheet (programId).
  programId       String?
  program         Program? @relation("ChallanItemProgram", fields: [programId], references: [id])
  // The incoming challan line this line was issued from (null on Fabric Store issues from stock).
  sourceChallanItemId String?
  sourceChallanItem   ChallanItem?  @relation("ChallanItemSource", fields: [sourceChallanItemId], references: [id], onDelete: SetNull)
  derivedItems        ChallanItem[] @relation("ChallanItemSource")
  createdAt       DateTime @default(now())

  shrinkage       ShrinkageRecord?

  @@index([programId])
  @@index([sourceChallanItemId])
}

// Shrinkage of one dyed fabric line (a line of a Dyeing -> Dyeing QC challan), recorded by Dyeing QC and
// shown read-only in the Fabric Store. One record per challan line. Information only: it never changes
// Fabric Store stock.
model ShrinkageRecord {
  id            String      @id @default(uuid())
  challanId     String
  challan       Challan     @relation(fields: [challanId], references: [id], onDelete: Cascade)
  challanItemId String      @unique
  challanItem   ChallanItem @relation(fields: [challanItemId], references: [id], onDelete: Cascade)
  programId     String
  program       Program     @relation(fields: [programId], references: [id])
  originalQty   Float       // the line quantity received from Dyeing
  originalUnit  String      // MTR | PCS
  shrinkageQty  Float
  shrinkageUnit String      // MTR | PCS
  remainingQty  Float?      // originalQty - shrinkageQty; null when the two units differ
  remarks       String?
  source        String      @default("MANUAL") // INSPECTION (entered with the Dyeing QC inspection) | MANUAL
  createdById   String
  createdBy     User        @relation("ShrinkageCreator", fields: [createdById], references: [id])
  updatedById   String
  updatedBy     User        @relation("ShrinkageUpdater", fields: [updatedById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([programId])
  @@index([challanId])
  @@index([updatedAt])
}

model ProductionTransaction {
  id              String   @id @default(uuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id])
  challanId       String
  challan         Challan  @relation(fields: [challanId], references: [id])
  departmentCode  String
  operationName   String
  operatorId      String
  operator        User     @relation("OperatorProduction", fields: [operatorId], references: [id])
  machineId       String?
  shift           String?

  inputQuantity   Float
  goodQuantity    Float
  reworkQuantity  Float    @default(0)
  rejectQuantity  Float    @default(0)
  wasteQuantity   Float    @default(0)
  balanceQuantity Float    @default(0)
  unitOfMeasure   String

  reworkReason    String?
  rejectReason    String?
  wasteReason     String?
  notes           String?
  recordedAt      DateTime @default(now())
}

model QualityInspection {
  id             String      @id @default(uuid())
  challanId      String
  challan        Challan     @relation(fields: [challanId], references: [id])
  programId      String
  departmentCode String
  inspectorId    String
  inspector      User        @relation("InspectorQuality", fields: [inspectorId], references: [id])
  sampleSize     Int
  status         String
  notes          String?
  inspectedAt    DateTime    @default(now())

  defects        DefectLog[]
  parameters     QualityInspectionParameter[]
}

model DefectLog {
  id           String            @id @default(uuid())
  inspectionId String
  inspection   QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  defectType   String
  count        Int
  severity     String
  createdAt    DateTime          @default(now())
}

model InventoryStock {
  id             String   @id @default(uuid())
  departmentCode String
  itemType       String
  identifier     String
  description    String
  currentQuantity Float
  uom            String
  programId      String?
  lastChallanId  String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([departmentCode, identifier])
}

// ==========================================
// 9. PHASE 2 — REAL EXECUTION ENGINE MODELS
// ==========================================

model ChallanEvent {
  id          String   @id @default(uuid())
  challanId   String
  challan     Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  action      String   // CREATE, SUBMIT, ISSUE, RECEIVE, START, COMPLETE, HOLD, RESUME, QC, HANDOVER, CLOSE, CANCEL
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  reason      String?
  notes       String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([challanId])
  @@index([actorId])
  @@index([createdAt])
}

model StockLedgerEntry {
  id             String   @id @default(uuid())
  entryType      String   // RECEIPT, ISSUE, RETURN, CONSUMPTION, ADJUSTMENT
  departmentCode String
  itemCode       String
  itemName       String
  batchNumber    String?
  lotNumber      String?
  rollNumber     String?
  colour         String?
  shade          String?
  location       String?
  quantity       Float    // signed: + for additions, - for deductions
  weightKg       Float?
  uom            String
  referenceType  String   // CHALLAN, PRODUCTION, DISPATCH, ADJUSTMENT, INITIAL
  referenceId    String?
  programId      String?
  program        Program? @relation(fields: [programId], references: [id])
  actorId        String
  actor          User     @relation(fields: [actorId], references: [id])
  balanceAfter   Float
  notes          String?
  idempotencyKey String?  @unique // one ledger movement per (document, line, revision); retries cannot double-post
  createdAt      DateTime @default(now())

  @@index([departmentCode, itemCode])
  @@index([referenceType, referenceId])
  @@index([batchNumber])
  @@index([lotNumber])
  @@index([rollNumber])
  @@index([programId])
}

model FabricRoll {
  id               String    @id @default(uuid())
  rollNumber       String    @unique // e.g. ROLL-001
  lotNumber        String?
  fabricCode       String
  fabricName       String
  colour           String
  shade            String?
  initialLengthMtr Float
  currentLengthMtr Float
  initialWeightKg  Float
  currentWeightKg  Float
  status           String    @default("RECEIVED") // RECEIVED, ISSUED, IN_INSPECTION, CUT, DEPLETED
  location         String?   // RACK-A-01
  programId        String?
  program          Program?  @relation(fields: [programId], references: [id])
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bundles          Bundle[]

  @@index([rollNumber])
  @@index([programId])
  @@index([status])
}

model Bundle {
  id                String         @id @default(uuid())
  bundleNumber      String         @unique // e.g. BND-2026-0001
  programId         String
  program           Program        @relation(fields: [programId], references: [id])
  challanId         String?
  challan           Challan?       @relation(fields: [challanId], references: [id])
  rollId            String?
  roll              FabricRoll?    @relation(fields: [rollId], references: [id])
  rollNumber        String?
  layNumber         String?
  markerNumber      String?
  patternNumber     String?
  size              String
  colour            String
  shade             String?
  quantity          Int
  remainingQuantity Int
  currentDepartment String         @default("CUTTING")
  status            String         @default("CREATED") // CREATED, IN_TRANSIT, IN_PROCESS, COMPLETED, REWORK, REJECTED, PACKED
  barcode           String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  defects           DefectRecord[]
  cartonItems       CartonBundle[]
  recutRequests     RecutRequest[] @relation("OriginalBundleRecuts")
  replacementFor    RecutRequest[] @relation("ReplacementBundleRecuts")

  @@index([bundleNumber])
  @@index([programId])
  @@index([currentDepartment])
  @@index([status])
}

model Carton {
  id               String         @id @default(uuid())
  cartonNumber     String         @unique // e.g. CTN-2026-0001
  programId        String
  program          Program        @relation(fields: [programId], references: [id])
  packingChallanId String?
  size             String
  colour           String
  quantity         Int
  grossWeightKg    Float?
  netWeightKg      Float?
  status           String         @default("PACKED") // PACKED, IN_FG_STORE, STAGED_FOR_DISPATCH, DISPATCHED
  locationRack     String?
  locationShelf    String?
  barcode          String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  bundles          CartonBundle[]
  dispatchCartons  DispatchCarton[]

  @@index([cartonNumber])
  @@index([programId])
  @@index([status])
}

model CartonBundle {
  id        String   @id @default(uuid())
  cartonId  String
  carton    Carton   @relation(fields: [cartonId], references: [id], onDelete: Cascade)
  bundleId  String
  bundle    Bundle   @relation(fields: [bundleId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartonId, bundleId])
}

model DispatchOrder {
  id              String           @id @default(uuid())
  dispatchNumber  String           @unique // e.g. DSP-2026-0001
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  orderNumber     String
  invoiceNumber   String?
  transporterName String
  vehicleNumber   String
  lrNumber        String?          // Lorry Receipt
  destination     String
  totalCartons    Int
  totalQuantity   Int
  totalWeightKg   Float?
  status          String           @default("DRAFT") // DRAFT, APPROVED, DISPATCHED, DELIVERED, CANCELLED
  approvedById    String?
  approvedBy      User?            @relation("DispatchApprover", fields: [approvedById], references: [id])
  dispatchedById  String?
  dispatchedBy    User?            @relation("DispatchOperator", fields: [dispatchedById], references: [id])
  dispatchedAt    DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  cartons         DispatchCarton[]

  @@index([dispatchNumber])
  @@index([status])
}

model DispatchCarton {
  id         String        @id @default(uuid())
  dispatchId String
  dispatch   DispatchOrder @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  cartonId   String
  carton     Carton        @relation(fields: [cartonId], references: [id])
  createdAt  DateTime      @default(now())

  @@unique([dispatchId, cartonId])
}

model DefectRecord {
  id              String              @id @default(uuid())
  defectCode      String              // e.g. DEF-ST-01
  programId       String
  program         Program             @relation(fields: [programId], references: [id])
  challanId       String?
  challan         Challan?            @relation(fields: [challanId], references: [id])
  departmentCode  String
  bundleId        String?
  bundle          Bundle?             @relation(fields: [bundleId], references: [id])
  itemDescription String
  severity        String              // MINOR, MAJOR, CRITICAL
  quantity        Float
  uom             String?             // MTR | PCS; null on older records
  reason          String
  detectedById    String
  detectedBy      User                @relation("DefectDetector", fields: [detectedById], references: [id])
  status          String              @default("OPEN") // OPEN, UNDER_REVIEW, REWORK, RE-CUT, SCRAP, RELEASED, CLOSED
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  reworks         ReworkTransaction[]
  recutRequests   RecutRequest[]

  @@index([defectCode])
  @@index([programId])
  @@index([departmentCode])
  @@index([status])
}

model ReworkTransaction {
  id                   String        @id @default(uuid())
  defectId             String
  defect               DefectRecord  @relation(fields: [defectId], references: [id])
  programId            String
  program              Program       @relation(fields: [programId], references: [id])
  sourceTransactionId  String?
  departmentCode       String
  operationName        String
  operatorId           String
  operator             User          @relation("ReworkOperator", fields: [operatorId], references: [id])
  inputQuantity        Int
  outputGoodQuantity   Int
  outputRejectQuantity Int           @default(0)
  status               String        @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, SCRAPPED
  notes                String?
  createdAt            DateTime      @default(now())
  completedAt          DateTime?

  @@index([defectId])
  @@index([programId])
  @@index([status])
}

model RecutRequest {
  id                  String        @id @default(uuid())
  recutNumber         String        @unique // e.g. REC-2026-0001
  programId           String
  program             Program       @relation(fields: [programId], references: [id])
  defectId            String
  defect              DefectRecord  @relation(fields: [defectId], references: [id])
  originalBundleId    String?
  originalBundle      Bundle?       @relation("OriginalBundleRecuts", fields: [originalBundleId], references: [id])
  size                String
  colour              String
  requestedQuantity   Int
  reason              String
  requestedById       String
  requestedBy         User          @relation("RecutRequester", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?         @relation("RecutApprover", fields: [approvedById], references: [id])
  status              String        @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, COMPLETED
  replacementBundleId String?
  replacementBundle   Bundle?       @relation("ReplacementBundleRecuts", fields: [replacementBundleId], references: [id])
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([recutNumber])
  @@index([programId])
  @@index([status])
}

model QualityInspectionParameter {
  id             String            @id @default(uuid())
  inspectionId   String
  inspection     QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  parameterName  String            // Width, GSM, Shrinkage, StitchDensity, ChestSize, etc.
  expectedValue  String?
  measuredValue  String
  tolerance      String?
  uom            String?
  status         String            // PASS, FAIL, OBSERVATION
  comments       String?
  createdAt      DateTime          @default(now())

  @@index([inspectionId])
}

// ==========================================
// 10. PHASE 3: RESILIENCE, INTEGRITY & ALERTS
// ==========================================

model IdempotencyRecord {
  id             String   @id @default(uuid())
  key            String   @unique
  endpoint       String
  method         String
  statusCode     Int
  responseBody   String   @db.Text
  createdAt      DateTime @default(now())

  @@index([key])
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  message     String
  category    String    // CHALLAN_PENDING, QC_PENDING, QC_FAILED, MATERIAL_SHORTAGE, STALLED_PRODUCTION, OVERDUE_HANDOFF, PROGRAM_RISK, REWORK_PENDING, DISPATCH_PENDING
  severity    String    // INFO, WARNING, CRITICAL
  entityType  String?   // PROGRAM, CHALLAN, BUNDLE, DEFECT, etc.
  entityId    String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([isRead])
  @@index([createdAt])
}

model IntegrityScanResult {
  id             String   @id @default(uuid())
  scanType       String   // FULL_AUDIT, INVENTORY_LEDGER, CHALLAN_GENEALOGY, PRODUCTION_BALANCE
  issuesFound    Int
  detailsJson    String   @db.Text
  status         String   // CLEAN, ISSUES_DETECTED, RECONCILED
  remediatedAt   DateTime?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ==========================================
// 11. FABRIC STORE DEPARTMENT
// ==========================================

enum InventoryLocationType {
  RACK
  BIN
  FLOOR
  QUARANTINE
  DISPATCH
}

model InventoryLocation {
  id           String                @id @default(uuid())
  locationCode String                @unique // e.g. "RACK-A1", "BIN-B3"
  locationName String
  locationType InventoryLocationType @default(RACK)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  rolls        FabricStoreRoll[]     @relation("RollLocation")
  fromLedger   FabricStockLedger[]   @relation("LedgerFromLocation")
  toLedger     FabricStockLedger[]   @relation("LedgerToLocation")

  @@index([locationCode])
  @@index([isActive])
}

enum FabricBatchStatus {
  PENDING_RECEIPT
  PARTIALLY_RECEIVED
  RECEIVED
  IN_STOCK
  PARTIALLY_ISSUED
  FULLY_ISSUED
  REJECTED
}

model FabricBatch {
  id                 String            @id @default(uuid())
  batchNumber        String            @unique // auto-generated "BATCH-YYYY-NNNN"
  programId          String?
  program            Program?          @relation(fields: [programId], references: [id])
  supplierId         String?           // supplier name or reference
  fabricType         String            // "KORA", "DYED", "WOVEN", "BLENDED"
  fabricDescription  String
  colorCode          String?
  colorName          String?
  totalRolls         Int               @default(0)
  totalMeters        Decimal           @default(0) @db.Decimal(10, 2) // total quantity, in `unit`
  unit               String            @default("MTR") // "MTR" | "PCS"; every roll in the batch uses this unit
  status             FabricBatchStatus @default(PENDING_RECEIPT)
  receivedAt         DateTime?
  createdById        String
  createdBy          User              @relation("FabricBatchCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  rolls              FabricStoreRoll[]
  receipts           MaterialReceipt[]
  ledgerEntries      FabricStockLedger[]

  @@index([batchNumber])
  @@index([status])
  @@index([programId])
}

enum FabricRollStatus {
  RECEIVED
  QC_HOLD
  QC_PASSED
  QC_REJECTED
  IN_STOCK
  ISSUED
  RETURNED
  CONSUMED
}

enum FabricQCStatus {
  PENDING
  PASSED
  FAILED
  ON_HOLD
}

model FabricStoreRoll {
  id                 String          @id @default(uuid())
  rollNumber         String          @unique // auto-generated "ROLL-YYYY-NNNN"
  batchId            String
  batch              FabricBatch     @relation(fields: [batchId], references: [id])
  locationId         String?
  location           InventoryLocation? @relation("RollLocation", fields: [locationId], references: [id])
  length             Decimal         @db.Decimal(10, 2) // quantity in batch.unit (MTR or PCS)
  width              Decimal?        @db.Decimal(10, 2) // cm
  weight             Decimal?        @db.Decimal(10, 3) // kg
  status             FabricRollStatus @default(RECEIVED)
  qcStatus           FabricQCStatus  @default(PENDING)
  qcInspectedById    String?
  qcInspectedBy      User?           @relation("FabricRollQCInspector", fields: [qcInspectedById], references: [id])
  qcInspectedAt      DateTime?
  qcRemarks          String?
  programIssuedToId  String?
  programIssuedTo    Program?        @relation("FabricRollIssuedToProgram", fields: [programIssuedToId], references: [id])
  issuedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  receiptItems       MaterialReceiptItem[]
  qcInspections      FabricQCInspection[]
  ledgerEntries      FabricStockLedger[]

  @@index([rollNumber])
  @@index([batchId])
  @@index([status])
  @@index([qcStatus])
}

enum GRNStatus {
  DRAFT
  CONFIRMED
  QC_PENDING
  QC_COMPLETE
  CLOSED
}

model MaterialReceipt {
  id                  String       @id @default(uuid())
  grnNumber           String       @unique // auto-generated "GRN-YYYY-NNNN"
  batchId             String
  batch               FabricBatch  @relation(fields: [batchId], references: [id])
  challanId           String?      // optional incoming delivery challan
  receivedById        String
  receivedBy          User         @relation("GRNReceiver", fields: [receivedById], references: [id])
  receivedAt          DateTime
  vehicleNumber       String?
  supplierName        String
  totalRollsReceived  Int          @default(0)
  totalMetersReceived Decimal      @default(0) @db.Decimal(10, 2)
  status              GRNStatus    @default(DRAFT)
  remarks             String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  items               MaterialReceiptItem[]

  @@index([grnNumber])
  @@index([status])
  @@index([batchId])
}

model MaterialReceiptItem {
  id              String          @id @default(uuid())
  receiptId       String
  receipt         MaterialReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  rollId          String
  roll            FabricStoreRoll @relation(fields: [rollId], references: [id])
  measuredLength  Decimal         @db.Decimal(10, 2)
  measuredWeight  Decimal?        @db.Decimal(10, 3)
  remarks         String?
  createdAt       DateTime        @default(now())

  @@index([receiptId])
  @@index([rollId])
}

enum InspectionType {
  RECEIPT_QC
  RETURN_QC
  RANDOM_QC
}

enum InspectionResult {
  PASS
  HOLD
  REJECT
}

model FabricQCInspection {
  id               String          @id @default(uuid())
  inspectionNumber String          @unique // auto-generated "QCI-YYYY-NNNN"
  rollId           String
  roll             FabricStoreRoll @relation(fields: [rollId], references: [id])
  inspectedById    String
  inspectedBy      User            @relation("FabricQCInspector", fields: [inspectedById], references: [id])
  inspectionType   InspectionType  @default(RECEIPT_QC)
  result           InspectionResult
  defects          Json?           // array of defect objects
  remarks          String?
  inspectedAt      DateTime
  createdAt        DateTime        @default(now())

  @@index([inspectionNumber])
  @@index([rollId])
  @@index([result])
}

enum StockTransactionType {
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT
  WRITE_OFF
  TRANSFER
}

model FabricStockLedger {
  id              String               @id @default(uuid())
  entryNumber     String               @unique // auto-generated "SLE-YYYY-NNNN"
  rollId          String
  roll            FabricStoreRoll      @relation(fields: [rollId], references: [id])
  batchId         String
  batch           FabricBatch          @relation(fields: [batchId], references: [id])
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(10, 2) // amount moved, in batch.unit (MTR or PCS)
  referenceType   String               // "GRN", "ISSUE_CHALLAN", "RETURN_CHALLAN", "QC_HOLD"
  referenceId     String               // the relevant document ID
  fromLocationId  String?
  fromLocation    InventoryLocation?   @relation("LedgerFromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String?
  toLocation      InventoryLocation?   @relation("LedgerToLocation", fields: [toLocationId], references: [id])
  transactedById  String
  transactedBy    User                 @relation("FabricLedgerTransactor", fields: [transactedById], references: [id])
  transactedAt    DateTime
  remarks         String?
  createdAt       DateTime             @default(now())

  @@index([entryNumber])
  @@index([rollId])
  @@index([batchId])
  @@index([transactionType])
  @@index([transactedAt])
}

// ==========================================
// 17. DYEING DEPARTMENT PRODUCTION MODULE
// ==========================================

model DyeingOrder {
  id                   String     @id @default(uuid())
  orderNumber          String     @unique // e.g. DYE-2026-0001
  programId            String
  program              Program    @relation(fields: [programId], references: [id])
  inboundChallanId     String?
  inboundChallan       Challan?   @relation("DyeingInboundChallan", fields: [inboundChallanId], references: [id])
  // One order per Store -> Dyeing challan line (null on orders created before per-line tracking).
  inboundChallanItemId String?    @unique

  // AWAITING_RECEIPT, RECEIVED, IN_DYEING, PARTIALLY_DYED, DYED, READY_FOR_QC1, PARTIALLY_SENT_TO_QC1, SENT_TO_QC1
  status               String     @default("RECEIVED")
  priority             String     @default("NORMAL")   // LOW, NORMAL, HIGH, URGENT

  fabricName           String
  fabricType           String?
  targetColor          String
  dyedColor            String?
  colorCode            String?

  requiredQuantity     Float
  dyedQuantity         Float      @default(0)
  undyedQuantity       Float      @default(0)
  readyForQc1Quantity  Float      @default(0)
  sentToQc1Quantity    Float      @default(0)
  uom                  String     @default("MTR")

  // Receipt: what physically arrived (null until received; legacy orders received before this existed).
  receivedQuantity     Float?
  // The line's second quantity (its Unit quantity in the other unit) as received; never converted.
  receivedUnitQuantity    Float?
  receivedUnitQuantityUom String?
  receivedAt           DateTime?
  receivedById         String?
  receivedBy           User?      @relation("DyeingReceiver", fields: [receivedById], references: [id])
  receiptRemarks       String?

  expectedCompletionDate DateTime?

  // Actual dyed colour differs from the required colour: must be reviewed before transfer to QC.
  colorMismatch        Boolean    @default(false)
  colorReviewNote      String?
  colorReviewedById    String?
  colorReviewedBy      User?      @relation("DyeingColorReviewer", fields: [colorReviewedById], references: [id])
  colorReviewedAt      DateTime?

  qcTransfers          DyeingQcTransfer[]

  inchargeId           String?
  incharge             User?      @relation("DyeingInchargeUser", fields: [inchargeId], references: [id])
  inchargeName         String?

  batchNumber          String?
  machineNumber        String?
  processRemarks       String?

  qc1ChallanId         String?
  qc1Challan           Challan?   @relation("DyeingQc1Challan", fields: [qc1ChallanId], references: [id])

  startedAt            DateTime?
  completedAt          DateTime?
  sentToQc1At          DateTime?

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([programId])
  @@index([status])
  @@index([orderNumber])
}

// One row per quantity of a DyeingOrder sent to Dyeing QC on a Dyeing -> QC1 challan line.
// Partial transfers create several rows; the order's sentToQc1Quantity is their sum.
model DyeingQcTransfer {
  id              String      @id @default(uuid())
  dyeingOrderId   String
  dyeingOrder     DyeingOrder @relation(fields: [dyeingOrderId], references: [id], onDelete: Cascade)
  challanId       String
  challan         Challan     @relation("DyeingQcTransferChallan", fields: [challanId], references: [id], onDelete: Cascade)
  challanItemId   String      @unique
  quantity        Float
  uom             String
  actualDyedColor String?
  createdById     String
  createdBy       User        @relation("DyeingQcTransferCreator", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())

  @@index([dyeingOrderId])
  @@index([challanId])
}

// One incoming challan line as work in a downstream department (Embroidery now; Thread Cutting and
// later departments reuse it). Quantities only move forward: expected -> received -> processed ->
// transferred, so nothing is counted twice.
model DepartmentWorkItem {
  id                     String    @id @default(uuid())
  departmentCode         String    // EMBROIDERY, THREAD_CUTTING ...
  itemNumber             String    @unique // e.g. EMB-2026-0001
  programId              String
  program                Program   @relation(fields: [programId], references: [id])
  inboundChallanId       String
  inboundChallan         Challan   @relation("WorkItemInboundChallan", fields: [inboundChallanId], references: [id])
  inboundChallanItemId   String
  sourceDepartment       String    // department that sent the line (STORE, QC1 ...)

  fabricName             String
  colour                 String?
  fabricProcessingStatus String    // DYED | UNDYED, from the validated route
  fabricStatusSource     String    @default("ROUTE") // ROUTE | CORRECTED (admin correction, audited)

  status                 String    @default("AWAITING_RECEIPT") // AWAITING_RECEIPT, RECEIVED, IN_PROGRESS, COMPLETED, READY_FOR_TRANSFER, PARTIALLY_TRANSFERRED, TRANSFERRED
  priority               String    @default("NORMAL")
  uom                    String
  expectedQuantity       Float
  receivedQuantity       Float?
  // The line's second quantity (its Unit quantity in the other unit, MTR or PCS) as received; never converted.
  receivedUnitQuantity    Float?
  receivedUnitQuantityUom String?
  processedQuantity      Float     @default(0) // QC departments: inspected
  transferredQuantity    Float     @default(0) // QC departments: PASS sent onward
  // Garment lines (Stitching onward): category and style from the Recutting allocation.
  garmentCategory        String?   // TOP | BOTTOM | DUPATTA | OTHERS
  styleRef               String?
  sourceAllocationId     String?
  sourceAllocation       WorkItemAllocation? @relation("WorkItemSourceAllocation", fields: [sourceAllocationId], references: [id], onDelete: SetNull)
  // The previous department's line this one was issued from (e.g. the Stitching line a Finishing line came from).
  sourceWorkItemId       String?
  sourceWorkItem         DepartmentWorkItem?  @relation("WorkItemSource", fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  downstreamWorkItems    DepartmentWorkItem[] @relation("WorkItemSource")
  fabricPhotos           FabricPhoto[]
  // Production departments that take work onto the floor (Stitching): taken in, and defective
  // (kept apart from good processedQuantity; recorded as DefectRecord).
  takenQuantity          Float     @default(0)
  defectQuantity         Float     @default(0)
  // QC departments only: inspection outcomes, and how much of each has left on a challan.
  passedQuantity         Float     @default(0)
  rejectedQuantity       Float     @default(0)
  reworkQuantity         Float     @default(0)
  rejectSentQuantity     Float     @default(0)
  reworkSentQuantity     Float     @default(0)

  receivedAt             DateTime?
  receivedById           String?
  receivedBy             User?     @relation("WorkItemReceiver", fields: [receivedById], references: [id])
  receiptRemarks         String?
  expectedCompletionDate DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  lastTransferredAt      DateTime?
  remarks                String?

  transfers              DepartmentWorkTransfer[]
  inspections            WorkItemInspection[]
  allocations            WorkItemAllocation[]
  packingAllocations     PackingAllocation[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([departmentCode, inboundChallanItemId])
  @@index([departmentCode, status])
  @@index([programId])
  @@index([inboundChallanId])
}

// A quantity of a work item sent to the next department on one outgoing challan line.
model DepartmentWorkTransfer {
  id                     String             @id @default(uuid())
  workItemId             String
  workItem               DepartmentWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  challanId              String
  challan                Challan            @relation("WorkTransferChallan", fields: [challanId], references: [id], onDelete: Cascade)
  challanItemId          String             @unique
  quantity               Float
  uom                    String
  fabricProcessingStatus String
  kind                   String             @default("PASS") // PASS (next department) | REJECT (defective shelf) | REWORK (back for rework)
  allocationId           String?            // Recutting: the category/style allocation this line was issued from
  allocation             WorkItemAllocation? @relation(fields: [allocationId], references: [id])
  createdById            String
  createdBy              User               @relation("WorkTransferCreator", fields: [createdById], references: [id])
  createdAt              DateTime           @default(now())

  @@index([workItemId])
  @@index([challanId])
}

// Recutting: part of a received line allocated to a garment category and style. allocatedQuantity
// uses the line's unit and comes out of its received balance; cutQuantity is what was actually cut,
// in its own unit (MTR or PCS, never converted automatically), and is what Stitching may receive.
model WorkItemAllocation {
  id                  String             @id @default(uuid())
  allocationNumber    String             @unique // e.g. RCA-2026-0001
  workItemId          String
  workItem            DepartmentWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  category            String             // TOP | BOTTOM | DUPATTA | OTHERS
  otherName           String?            // OTHERS: the item / category name
  styleRef            String?
  allocatedQuantity   Float              // in the work item's uom
  allocatedUom        String
  cutQuantity         Float              @default(0) // in cutUom
  cutUom              String             // MTR | PCS
  transferredQuantity Float              @default(0) // in cutUom, sent to Stitching
  status              String             @default("ALLOCATED") // ALLOCATED, CUT, PARTIALLY_TRANSFERRED, TRANSFERRED, CANCELLED
  remarks             String?
  createdById         String
  createdBy           User               @relation("AllocationCreator", fields: [createdById], references: [id])
  cancelledAt         DateTime?
  cancelReason        String?
  transfers           DepartmentWorkTransfer[]
  downstreamItems     DepartmentWorkItem[] @relation("WorkItemSourceAllocation")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([workItemId])
  @@index([category])
}

// One inspection batch of a QC department work item. Batches add up: the item's inspected, passed,
// rejected and rework quantities are the sums of its batches, so no quantity is inspected twice.
model WorkItemInspection {
  id                String             @id @default(uuid())
  workItemId        String
  workItem          DepartmentWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  inspectedQuantity Float
  passQuantity      Float              @default(0)
  rejectQuantity    Float              @default(0)
  reworkQuantity    Float              @default(0)
  uom               String
  rejectReason      String?
  reworkReason      String?
  remarks           String?
  inspectorId       String
  inspector         User               @relation("WorkItemInspector", fields: [inspectorId], references: [id])
  createdAt         DateTime           @default(now())

  @@index([workItemId])
}

// ==========================================
// 18. FABRIC STORE INWARD & OUTWARD STOCK
// ==========================================

model FabricInward {
  id            String    @id @default(uuid())
  sNo           Int       @default(autoincrement())
  entryType     String    // "KORA" or "DYED"
  itemName      String    // e.g. "Cotton 60x60 Cambric"
  billNo        String    // Supplier bill / invoice number
  billDate      DateTime  // Bill Date
  receivingDate DateTime  // Date received in store
  billQty       Float     // Quantity
  unit          String    @default("MTR") // "MTR" or "PCS"; never converted
  colour        String?   // null on entries recorded before colour tracking
  supplierName  String?    // Party name
  billerStateCity String?  // Biller state / city
  pricePerUnit  Float?     // per MTR or PCS, as billed
  boxThanQty    Float?     // boxes / thans received
  hsnCode       String?
  taxPercent    Float?
  remarks       String?
  // Roll / commercial details (Excel stock import; null on manual entries)
  rollNumber          String?
  rollKey             String?   @unique // normalized supplier + roll number; one roll per supplier
  batchNumber         String?
  shade               String?
  composition         String?
  width               String?
  unitRate            Float?
  storageLocation     String?
  purchaseOrderNumber String?
  importId            String?
  import              FabricStockImport? @relation(fields: [importId], references: [id])
  importRowNumber     Int?      // worksheet row the entry came from
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([entryType])
  @@index([billNo])
  @@index([receivingDate])
  @@index([importId])
}

model FabricOutward {
  id            String    @id @default(uuid())
  sNo           Int       @default(autoincrement())
  date          DateTime  @default(now())
  challanNumber String?
  challanId     String?
  designNumber  String?
  itemName      String
  issueQty      Float     // meters or units issued
  unit          String    @default("MTR")
  colour        String?
  avgPerPcs     Float?    // avg fabric per pcs
  issuePcsQty   Float?    // pcs quantity
  byOrderName   String?   // by order name / client name
  remarks       String?
  inchargeName  String?   // the Fabric Store incharge's name as typed on the form
  destination   String?   // "DYEING", "EMBROIDERY", "OTHER"
  fabricType    String?   // "KORA", "DYED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([challanNumber])
  @@index([designNumber])
  @@index([date])
}

// Excel stock inward import. The uploaded workbook is evidence only; stock changes when an
// authorized user confirms a fully valid import, which creates FabricInward rows and posts them
// to StockLedgerEntry in one transaction. A posted import is the inward receipt.
model FabricStockImport {
  id               String    @id @default(uuid())
  status           String    @default("UPLOADED") // see lib/fabric-stock-import/state.mjs
  fileName         String    // as uploaded; display only, never used as a path
  fileHash         String    // SHA-256 of the file bytes
  fileSize         Int
  fileData         Bytes     // original workbook, served only to authorized users
  sheetsJson       String    @db.Text // cell values of each worksheet, read once at upload
  selectedSheet    String?
  headerRow        Int?
  mappingJson      String?   @db.Text
  correctionsJson  String?   @db.Text
  resolutionsJson  String?   @db.Text
  validationJson   String?   @db.Text
  payloadHash      String?   // hash of the rows the user previewed; confirmation must match it
  receiptNumber    String?   @unique
  confirmKey       String?   @unique // idempotency key of the confirmation that posted it
  postedAt         DateTime?
  postedById       String?
  postedBy         User?     @relation("FabricStockImportPoster", fields: [postedById], references: [id])
  postedResultJson String?   @db.Text
  failureReason    String?
  uploadedById     String
  uploadedBy       User      @relation("FabricStockImportUploader", fields: [uploadedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inwards          FabricInward[]
  documents        FabricStockImportDocument[]

  @@index([fileHash])
  @@index([status])
  @@index([createdAt])
}

// Images embedded in an imported workbook (scanned invoices, delivery challans), kept as evidence.
model FabricStockImportDocument {
  id        String            @id @default(uuid())
  importId  String
  import    FabricStockImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind      String            // EMBEDDED_IMAGE
  sheetName String?
  mimeType  String
  size      Int
  sha256    String
  data      Bytes
  ocrStatus String            @default("NOT_CONFIGURED") // OCR is not enabled; see docs/fabric-store-stock-inward/OCR_DESIGN.md
  createdAt DateTime          @default(now())

  @@index([importId])
}

// ==========================================
// 19. SMART DEADLINE ALERTS
// ==========================================

// One row per (department, task, stage, deadline day). Rows are never deleted: an alert is
// resolved when the task closes, the deadline moves or the next stage starts.
model DeadlineAlert {
  id                   String    @id @default(uuid())
  dedupKey             String    @unique // DEPT:ENTITY_TYPE:ENTITY_ID:STAGE:DEADLINE_DAY
  departmentCode       String    // DYEING, QC1, EMBROIDERY, THREAD_CUTTING ...
  entityType           String    // DYEING_ORDER, CHALLAN
  entityId             String
  programId            String?
  program              Program?  @relation(fields: [programId], references: [id])
  challanId            String?
  challan              Challan?  @relation(fields: [challanId], references: [id])

  alertType            String    // DUE_SOON, DUE_TODAY, OVERDUE
  thresholdDays        Int?      // 7, 3, 1 for DUE_SOON; 0 for DUE_TODAY; null for OVERDUE
  severity             String    // INFO, WARNING, CRITICAL

  deadlineAt           DateTime  // Snapshot of the delivery date the alert was raised for
  deadlineDay          String    // Factory-local calendar day of deadlineAt (YYYY-MM-DD)
  timeZone             String    // Factory time zone used for deadlineDay
  workStatus           String    // Task status at the last evaluation
  taskLabel            String    // e.g. "Dyeing DYE-2026-0007"
  productionSheetId    String?   // Program serial / number snapshot
  designNumber         String?
  challanNumber        String?
  recipientDepartments String[]  // Departments whose members see the alert (admins always do)

  status               String    @default("ACTIVE") // ACTIVE, RESOLVED
  resolvedReason       String?   // COMPLETED, CANCELLED, CLOSED, DEADLINE_CHANGED, SUPERSEDED, NO_LONGER_DUE
  activatedAt          DateTime  @default(now()) // Last time the alert became active; earlier dismissals no longer apply
  lastEvaluatedAt      DateTime  @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  dismissals           DeadlineAlertDismissal[]

  @@index([departmentCode, status])
  @@index([entityType, entityId, status])
  @@index([programId])
  @@index([challanId])
}

// Per-user dismissal history. Dismissing never changes the task, challan, dates or quantities.
model DeadlineAlertDismissal {
  id          String        @id @default(uuid())
  alertId     String
  alert       DeadlineAlert @relation(fields: [alertId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  dismissedAt DateTime      @default(now())

  @@index([alertId, userId])
  @@index([userId, dismissedAt])
}

// Inventory: part of a received finished-garment line (DepartmentWorkItem, department INVENTORY)
// sent for packing, in whole pieces. The line keeps the totals: takenQuantity = sent for packing
// (net of returns), processedQuantity = packed. Every change is also posted to StockLedgerEntry.
model PackingAllocation {
  id               String             @id @default(uuid())
  packingNumber    String             @unique // e.g. PKG-2026-0001
  workItemId       String
  workItem         DepartmentWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  quantity         Int                // pieces sent for packing
  packedQuantity   Int                @default(0)
  returnedQuantity Int                @default(0) // sent back to inventory unpacked
  status           String             @default("SENT_FOR_PACKING") // SENT_FOR_PACKING, PACKING_IN_PROGRESS, PARTIALLY_PACKED, PACKING_COMPLETED, CANCELLED
  priority         String             @default("NORMAL")
  packingDate      DateTime
  remarks          String?
  createdById      String
  createdBy        User               @relation("PackingAllocationCreator", fields: [createdById], references: [id])
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([workItemId])
  @@index([status])
}

// Complete-garment photo for one design (Production Sheet) and garment category, optionally one
// style. Kept apart from Wilcom and fabric photos. Stored like DepartmentImage: Cloudinary when
// configured, otherwise the bytes in imageData. Replacing bumps version (the image route's ETag).
model GarmentImage {
  id              String   @id @default(uuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  garmentCategory String   // TOP | BOTTOM | DUPATTA | OTHERS, or "" when the line has none
  styleRef        String   @default("") // "" = the whole category
  storageProvider String   // CLOUDINARY | DATABASE
  storageKey      String?
  imageUrl        String?
  imageData       Bytes?
  mimeType        String
  fileName        String
  fileSize        Int
  version         Int      @default(1)
  uploadedById    String?
  uploadedBy      User?    @relation("GarmentImageUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([programId, garmentCategory, styleRef])
}

// Fabric Store "Upload Stock Sheet" (photo, scan or Excel). Audit record of one uploaded file: the original
// bytes, the rows read from it, and - once a user confirmed the reviewed rows - who confirmed and which
// FabricInward rows were created. Unconfirmed imports never touch stock.
model StockImport {
  id            String    @id @default(uuid())
  source        String    // IMAGE or EXCEL
  fileName      String
  mimeType      String
  fileSize      Int
  fileHash      String    // sha256 of the file; the same file uploaded again is flagged
  fileData      Bytes
  status        String    @default("EXTRACTED") // EXTRACTED | CONFIRMED | DISCARDED
  extractedJson Json?     // rows and header exactly as read, with confidence and warnings
  rowCount      Int       @default(0)
  engine        String?   // e.g. claude-opus-5-5, sheetjs
  uploadedById  String
  uploadedAt    DateTime  @default(now())
  confirmKey    String?   @unique // idempotency key of the confirm request; a retry returns the same result
  confirmedById String?
  confirmedAt   DateTime?
  confirmedJson Json?     // rows as the user confirmed them
  resultJson    Json?     // created inward ids and skipped rows with reasons
  addedCount    Int       @default(0)
  skippedCount  Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@index([fileHash])
  @@index([uploadedAt])
}

// Manual migrations already applied (scripts/apply-appearance-migrations.js, run before the web app starts).
// Created by that script; kept here so prisma db push never treats the table as unknown.
model ManualMigration {
  name      String   @id
  checksum  String
  appliedAt DateTime @default(now())

  @@map("_manual_migrations")
}

// Fabric photo taken on a work line by Embroidery, Threadcut QC (QC2) or Stitching. Several per line are
// allowed and none replaces another. Departments later on the route see the photos of the Production Sheets
// they hold (lib/fabric-photos-server.ts). Bytes are kept in imageData, like GarmentImage.
model FabricPhoto {
  id             String             @id @default(uuid())
  programId      String
  program        Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  workItemId     String
  workItem       DepartmentWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  departmentCode String             // EMBROIDERY | QC2 | STITCHING: from the work line, never from the request
  fabricName     String?
  colour         String?
  imageData      Bytes
  mimeType       String
  fileName       String
  fileSize       Int
  fileHash       String             // sha256; the same file twice on one line is stored once
  uploadedById   String
  uploadedBy     User               @relation("FabricPhotoUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime           @default(now())

  @@unique([workItemId, fileHash])
  @@index([programId])
  @@index([workItemId])
}

// Quantity a department (Dyeing to Inventory) keeps back (HOLD) from one line it received: a work item, a dyeing
// order, or a Dyeing QC challan's MTR or PCS lines (lib/holds-server.ts).
// Remaining on HOLD is never more than the line still has unforwarded, so forwarding through the normal
// challan screens lowers it without a second deduction. One active HOLD per line (activeKey).
model DepartmentHold {
  id                    String                @id @default(uuid())
  holdNumber            String                @unique // e.g. HLD-2026-0001
  departmentCode        String
  sourceType            String // DYEING_ORDER | QC1_CHALLAN | WORK_ITEM
  sourceId              String
  sourceKey             String // sourceType:sourceId:unit
  activeKey             String?               @unique // departmentCode|sourceKey while the HOLD is open; null once closed
  programId             String
  program               Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  // Identifiers as they were when the HOLD was placed (kept after release).
  challanId             String?
  challanNumber         String?
  designNumber          String
  serialNumber          String
  productionSheetNumber String
  fabricName            String
  colour                String?
  size                  String?
  unit                  String // MTR | PCS, the line's own unit; never converted
  receivedQuantity      Float
  forwardedQuantity     Float // forwarded from the line, as last computed
  forwardedAtHold       Float // forwarded from the line when the HOLD was placed
  holdQuantity          Float
  releasedQuantity      Float                 @default(0)
  remainingQuantity     Float // still on HOLD, as last computed
  reason                String // PRODUCTION_PENDING, QUALITY_ISSUE ... OTHER (lib/holds.mjs)
  reasonOther           String? // the typed reason when reason is OTHER
  remarks               String?
  status                String                @default("ON_HOLD") // ON_HOLD, PARTIALLY_RELEASED, PARTIALLY_FORWARDED, RELEASED, FORWARDED, CLEARED
  heldById              String?
  heldBy                User?                 @relation("HoldPlacer", fields: [heldById], references: [id], onDelete: SetNull)
  heldByName            String
  heldAt                DateTime              @default(now())
  closedAt              DateTime?
  events                DepartmentHoldEvent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([departmentCode, status])
  @@index([programId])
  @@index([sourceKey])
}

// History of a HOLD: placed, released (in part or in full) and closed. Forwarding is read from the line's
// own transfer records (challans, allocations, packing), so it is never recorded twice.
model DepartmentHoldEvent {
  id             String         @id @default(uuid())
  holdId         String
  hold           DepartmentHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  action         String // HOLD | RELEASE | CLOSE
  quantity       Float
  remainingAfter Float
  unit           String
  remarks        String?
  actorId        String?
  actor          User?          @relation("HoldEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName      String
  createdAt      DateTime       @default(now())

  @@index([holdId])
}
