{
  "name": "@subham/database",
  "version": "1.0.0",
  "description": "Database schema, migrations, seeders, and Prisma client for Subham Fabrics MES",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "node -e \"if(!process.env.DATABASE_URL) process.env.DATABASE_URL='postgresql://neondb_owner:npg_1aZq9IghyRre@ep-red-bread-b4ddqxah-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require'; require('child_process').execSync('npx prisma generate', {stdio:'inherit', env:process.env});\"",
    "push": "prisma db push",
    "prebuild": "npm run generate",
    "build": "tsc && node -e \"const fs=require('fs'); try { fs.cpSync('src/generated', 'dist/generated', {recursive:true}); } catch(e) {}\"",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@subham/types": "*",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2"
  }
}
